# =============================================================
# Copie este arquivo para .env e preencha os valores reais
# cp .env.example .env && chmod 600 .env
# =============================================================

# ----- Database -----------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=shortnerdb

# ----- JWT ----------------------------------------------------
# Gere com: openssl rand -base64 32
JWT_SECRET_KEY=change-me-minimum-32-characters-long-random-string
JWT_ISSUER=Shortner.Api
JWT_AUDIENCE=Shortner.Api
JWT_EXPIRATION=60

# ----- Admin seed (criado na primeira inicialização) ----------
SEED_EMAIL=admin@yourdomain.com
SEED_PASSWORD=change-me-strong-admin-password

# ----- CORS ---------------------------------------------------
# Separe múltiplas origens com vírgula
# Ex: https://app.yourdomain.com,https://www.yourdomain.com
CORS_ORIGINS=https://yourdomain.com

# ----- PgAdmin (acesso via SSH tunnel: ssh -L 5050:127.0.0.1:5050 user@vps) ---
PGADMIN_EMAIL=admin@yourdomain.com
PGADMIN_PASSWORD=change-me-strong-password
